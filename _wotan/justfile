# https://just.systems

set unstable
set dotenv-load

default:
    just --choose

# Switch NixOS configuration for specific host (persists)
switch hostname:
    sudo nixos-rebuild switch --flake .#{{ hostname }}

# Switch both NixOS and home-manager configurations (home-manager is integrated)
switch-all hostname:
    just switch {{ hostname }}

# Test NixOS configuration (doesn't persist after reboot); defaults to wotan
test hostname="wotan":
    sudo nixos-rebuild test --flake .#{{ hostname }}

# Test both NixOS and home-manager configurations (home-manager is integrated)
test-all hostname:
    just test {{ hostname }}

# Build NixOS configuration (dry run to check)
build hostname:
    nix build .#nixosConfigurations.{{ hostname }}.config.system.build.toplevel --dry-run

# Build home-manager activation package (dry run to check)
build-home hostname="wotan" user="amadeus":
    nix build .#nixosConfigurations.{{ hostname }}.config.home-manager.users.{{ user }}.home.activationPackage --dry-run

# The attic recipes below need a one-time login on this machine:
#   attic login homelab https://cache.homelab.local/homelab <push-token>
# Paths already on cache.nixos.org are skipped, so only local builds upload.

# Push a closure to the homelab attic binary cache (defaults to this system)
attic-push path="/run/current-system" jobs="5":
    attic push -j {{ jobs }} homelab {{ path }}

# Build a host's system closure and push it to the homelab cache
attic-push-host hostname="wotan":
    attic push -j 5 homelab $(nix build --no-link --print-out-paths .#nixosConfigurations.{{ hostname }}.config.system.build.toplevel)

# Update flake inputs
update:
    nix flake update --accept-flake-config

# Update specific flake input
update-input input:
    nix flake update {{ input }} --accept-flake-config

# Format all Nix files with Alejandra
fmt:
    alejandra .

# Check flake configuration
check:
    nix flake check

# Enter development shell
dev:
    nix develop

# Clear terminal
clear:
    clear

d2-w: clear
    d2 -w docs/config.d2 docs/config.svg

d2: clear
    d2 --stdout-format ascii docs/config.d2 docs/config.svg
